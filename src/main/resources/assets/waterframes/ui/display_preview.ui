// PLAYER PANE DISPLAY SCREEN: TABS FILL THE LEFT COLUMN; THE RIGHT COLUMN STACKS THE 16:9 PREVIEW WITH ITS STATUS
// BADGE, THE NOW PLAYING TEXT, THE SEEKBAR AND THE KEYPAD. THE BLOCK EMBLEM RIDES OUTSIDE THE PANEL (§9.5).
theme "waterui"

import "tabs/sources" as sources
import "tabs/render" as render
import "tabs/media" as media
import "tabs/redstone" as redstone
import "constants/icons"

// ---- LIVE CONTRACT: ONE @UIVar OR REGISTERED SUPPLIER PER USED var --------------------------
var long time
var long duration
var loop
var paused
var muted
var loop_tooltip
var playback_tooltip
var mute_tooltip
var reload_ready
var Icon status_icon
var status_tooltip
var transport_ready
var String now_title
var String now_byline

// ---- BAKED CONTRACT: THE BLOCK EMBLEM STANDING OUTSIDE THE PANEL -----------------------------
final var ItemStack emblem_item
final var String emblem_name

root[frame=EDGE, orientation=HORIZONTAL, spacing=4, padding=0]

// LEFT COLUMN: THE TABS ALONE, SO THE PLAYLIST GETS THE FULL HEIGHT
ParentTab[id="display/tabs", width=FILL, height=FILL, tabs={sources, render, media, redstone}]

// RIGHT COLUMN: PLAYER PANE; THE SPACER PUSHES THE CONTROLS DOWN TO THE BOTTOM EDGE
Parent[orientation=VERTICAL, width=120, height=FILL, spacing=4] {
    // 16:9 PREVIEW (120x68) WITH THE STATUS BADGE OVER ITS TOP-RIGHT CORNER
    Frame[width=FILL, height=68, face=field] {
        MediaPlayer[id="display/preview", anchor=STRETCH]
        Icon[id="display/status", anchor=TOP|RIGHT, margin=2, width=12, height=12, icon=status_icon, tooltip=status_tooltip]
    }

    // NOW PLAYING: TITLE OVER THE BYLINE OF THE MEDIA ON AIR, EMPTY WHEN NOTHING PLAYS
    Text[component=now_title, textScale=0.6, ellipsize=true, lines=2, width=FILL]
    Text[component=now_byline, textScale=0.5, ellipsize=true, width=FILL]

    Spacer[width=FILL, height=FILL]

    SeekBar[id="display/seekbar", width=FILL, height=14, time=time, duration=duration,
            onSeekEnd=seek(), onScroll=skip()]

    // KEYPAD: ONE GRID SO BOTH ROWS SHARE COLUMNS. TRANSPORT ON TOP (THE PLAYBACK TOGGLE SHOWS PLAY
    // WHILE PAUSED AND PAUSE WHILE PLAYING), THEN LOOP, MUTE (CROSSED SPEAKER WHILE MUTED) AND RELOAD
    Grid[columns=4, rows=2, width=FILL, spacing=2] {
        Button[id="display/rewind", anchor=CENTER, width=20, height=20, icon=icon_rewind, enabled=transport_ready,
               onClick=rewind(), repeat={10, 3}]
        ToggleButton[id="display/playback", anchor=CENTER, width=24, height=20, iconOn=icon_play, iconOff=icon_pause,
                     value=paused, enabled=transport_ready, tooltip=playback_tooltip, onClick=togglePlayback()]
        Button[id="display/stop", anchor=CENTER, width=20, height=20, icon=icon_stop, enabled=transport_ready, onClick=stop()]
        Button[id="display/fast_forward", anchor=CENTER, width=20, height=20, icon=icon_fast_forward, enabled=transport_ready,
               onClick=fastForward(), repeat={10, 3}]
        ToggleButton[id="display/loop", anchor=CENTER, width=20, height=20, iconOn=icon_loop_on, iconOff=icon_loop_off,
                     value=loop, tooltip=loop_tooltip, onClick=toggleLoop()]
        ToggleButton[id="display/mute", anchor=CENTER, width=20, height=20, iconOn=icon_volume_0, iconOff=icon_volume,
                     value=muted, tooltip=mute_tooltip, onClick=toggleMute()]
        Blank
        Button[id="display/reload", anchor=CENTER, width=20, height=20, icon=icon_reload, enabled=reload_ready,
               tooltip="translatable:waterframes.gui.reload", onClick=reload()]
    }
}

// BLOCK EMBLEM: LIFTED OUT OF THE FLOW, SEATED OUTSIDE THE PANEL'S RIGHT EDGE, BOTTOM-FLUSH (§9.5)
ItemIcon[id="display/emblem", outsideAnchor=RIGHT|BOTTOM, width=62, height=62, margin=2,
         item=emblem_item, flipX=true, tooltip=emblem_name]
