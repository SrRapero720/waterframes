// WIDE DISPLAY SCREEN — LEFT COLUMN HOLDS TABS AND TRANSPORT, RIGHT COLUMN SHOWS A LIVE PREVIEW WITH DEDICATED CONTROLS.
// NO BLOCK EMBLEM IN THIS VARIANT. TABS AND STATE COME FROM THE IMPORTED DOCUMENTS AND THE HOST.
theme "waterui"

import "tabs/sources" as sources
import "tabs/render" as render
import "tabs/media" as media
import "tabs/redstone" as redstone
import "constants/icons"

// ---- LIVE CONTRACT: ONE @UIVar SUPPLIER PER USED var ----------------------------------------
var long time
var long duration
var loop
var loop_tooltip
var reload_ready
var Icon status_icon
var status_tooltip
var transport_ready

root[frame=EDGE, orientation=HORIZONTAL, spacing=4, padding=0]

// LEFT COLUMN — TABS AND TRANSPORT, SAME CONTENT AS display.ui MINUS THE MOVED CONTROLS
Parent[orientation=VERTICAL, width=FILL, height=FILL, spacing=0] {
    ParentTab[id="display/tabs", width=FILL, height=FILL, tabs={sources, render, media, redstone}]

    // TRANSPORT BAND — LOOP, SEEKBAR, RELOAD AND STATUS; PLAYBACK CONTROLS MOVED TO THE RIGHT KEYPAD
    Parent[id="display/transport", orientation=HORIZONTAL, align=CENTER, spacing=2, width=FILL, padding={4, 2}, face=field] {
        ToggleButton[id="display/loop", width=20, height=20, iconOn=icon_loop_on, iconOff=icon_loop_off,
                     value=loop, tooltip=loop_tooltip, onClick=toggleLoop()]
        SeekBar[id="display/seekbar", width=FILL, height=FILL, time=time, duration=duration,
                onSeekEnd=seek(), onScroll=skip()]
        Button[id="display/reload", width=20, height=20, icon=icon_reload, enabled=reload_ready,
               tooltip="translatable:waterframes.gui.reload", onClick=reload()]
        Icon[id="display/status", width=18, height=18, icon=status_icon, tooltip=status_tooltip]
    }
}

// RIGHT COLUMN — LIVE 4:3 PREVIEW ON TOP, KEYPAD PUSHED DOWN TO THE TRANSPORT LINE
Parent[orientation=VERTICAL, width=120, height=FILL, spacing=4, justify=BETWEEN] {
    MediaPlayer[id="display/preview", width=120, height=90, face=field]

    // TRANSPORT KEYPAD — REWIND, PLAY, PAUSE, STOP, FAST FORWARD; THE {0, 2} PADDING MATCHES THE
    // LEFT BAND'S HEIGHT SO BOTH SIT ON THE SAME BOTTOM LINE AND READ AS ONE STRIP
    Parent[orientation=HORIZONTAL, align=CENTER, width=FILL, padding={0, 2}, spacing=2, justify=CENTER, face=field] {
        Button[id="display/rewind", width=20, height=20, icon=icon_rewind, enabled=transport_ready,
               onClick=rewind(), repeat={10, 3}]
        Button[id="display/play", width=20, height=20, icon=icon_play, enabled=transport_ready,
               onClick=play()]
        Button[id="display/pause", width=20, height=20, icon=icon_pause, enabled=transport_ready,
               onClick=pause()]
        Button[id="display/stop", width=20, height=20, icon=icon_stop, enabled=transport_ready,
               onClick=stop()]
        Button[id="display/fast_forward", width=20, height=20, icon=icon_fast_forward, enabled=transport_ready,
               onClick=fastForward()]
    }
}
