// SHARED ICON TABLE — ONE loadAtlas LINE, THEN EVERY ICON AS COORDINATES ONLY (§5.7, §5.8).
// THE FULL ATLAS MAP LIVES HERE; Icons.java ONLY KEEPS WHAT JAVA PICKS AT RUNTIME.

final var gui = loadAtlas("screen_atlas")

// VOLUME COLUMN (chunk 0)
final var icon_volume            = gui(0, 0)
