// SOURCES TAB — URL ENTRY AND THE PLAYLIST BEHIND IT; LIST ROWS ARE DYNAMIC (DisplayScreen BINDS THEM).
// ROOT PREFS SHAPE THE AUTO-GENERATED TAB BODY (§6.1, §10.3): tabIcon/tabTooltip GO TO THE STRIP, THE REST IS LAYOUT.
import "constants/icons"
import "me.srrapero720.waterframes.client.ui.screen.widget.UrlField"

// ---- LIVE CONTRACT: SUBMIT BUTTON STATE AND DELETE GATE FROM THE HOST -----------------------
var Icon submit_icon
var submit_tooltip
var submit_enabled
var delete_enabled

root[tabIcon=icon_link, tabTooltip="translatable:waterframes.gui.tab.sources",
     orientation=VERTICAL, align=STRETCH, width=FILL, height=FILL, spacing=4]

Parent[orientation=HORIZONTAL, align=CENTER, spacing=2, width=FILL] {
    UrlField[id="sources/url", width=FILL, height=18, suggestion="https://i.imgur.com/1yCDs5C.mp4"]
    Button[id="sources/submit", width=18, height=18, icon=submit_icon, tooltip=submit_tooltip, enabled=submit_enabled, onClick=submit()]
    Button[id="sources/upload", width=18, height=18, icon=icon_upload, tooltip="translatable:waterframes.gui.source.upload", onClick=upload()]
}

// TEMPLATED LIST — SUNKEN nested CHROME; DisplayScreen SUBMITS THE KEYS, ROWS STAMP FROM widgets/source_entry.
// groupBy MAKES A MEDIA AND ITS EXPANDED SOURCES TRAVEL AS ONE BLOCK IN THE INTEGRATED DRAG (§10.6)
ParentList[id="sources/list", entry="widgets/source_entry", width=FILL, height=FILL, spacing=2, padding=2,
           scrollY=true, face=nested, groupBy="group", onListMove=moveEntry()]

Parent[orientation=HORIZONTAL, align=CENTER, spacing=2, width=FILL] {
    Button[width=18, height=18, icon=icon_copy_from, enabled=false, tooltip="translatable:waterframes.gui.source.copy_from"]
    Button[width=18, height=18, icon=icon_copy_to, enabled=false, tooltip="translatable:waterframes.gui.source.copy_to"]
    Button[id="sources/delete", width=18, height=18, icon=icon_delete, tooltip="translatable:waterframes.gui.source.delete", enabled=delete_enabled, onClick=deleteSource()]
    Spacer[width=FILL, height=FILL]
}
